generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  priceCents  Int
  currency    String   @default("BBD")

  // SQLite-friendly: store category as string (validated in API)
  category    String

  imageUrl    String?
  // SQLite can't store String[]; store JSON string like ["url1","url2"]
  imageUrls   String   @default("[]")
  stockQty    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

model Order {
  id               String      @id @default(cuid())
  status           String      @default("PENDING")
  currency         String      @default("BBD")
  subtotalCents    Int
  shippingCents    Int
  totalCents       Int
  customerName     String
  customerEmail    String?
  customerPhone    String?
  shippingAddress1 String
  shippingAddress2 String?
  parish           String?
  shippingCountry  String      @default("Barbados")
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
  titleSnapshot  String
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
