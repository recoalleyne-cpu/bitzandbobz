generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  priceCents  Int
  currency    String   @default("BBD")
  category    Category
  imageUrl    String?
  imageUrls   String[] @default([])
  stockQty    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id               String      @id @default(cuid())
  status           OrderStatus @default(PENDING)
  currency         String      @default("BBD")
  subtotalCents    Int
  shippingCents    Int
  totalCents       Int
  customerName     String
  customerEmail    String?
  customerPhone    String?
  shippingAddress1 String
  shippingAddress2 String?
  parish           String?
  shippingCountry  String      @default("Barbados")
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int
  unitPriceCents Int
  titleSnapshot String
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  CANCELLED
}

enum Category {
  CAR_ACCESSORIES
  DIY_TOOLS_GADGETS
  MENS_ACCESSORIES
  PHONE_ACCESSORIES
  SPECIAL
  WOMENS_ACCESSORIES
}
