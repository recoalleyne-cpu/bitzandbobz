{
  "dependencies": {
    "@bitz/config": "workspace:*",
    "@prisma/client": "5.22.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "zod": "^4.3.6",
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.0",
    "prisma": "5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  },
  "scripts": {
    "predev": "pnpm --dir ../.. --filter @bitz/config build",
    "prebuild": "pnpm --dir ../.. --filter @bitz/config build",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "seed": "ts-node-dev --transpile-only src/seed.ts",
    "seed:compiled": "node dist/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-check.js"
  }
}