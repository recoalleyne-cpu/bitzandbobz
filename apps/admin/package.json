{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --dir ../.. --filter @bitz/config build",
    "prebuild": "pnpm --dir ../.. --filter @bitz/config build",
